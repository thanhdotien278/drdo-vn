{
  "name": "drdo-vn",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @drdo/api",
    "dev:web": "npm run dev -w @drdo/web",
    "build": "npm run build -w @drdo/api && npm run build -w @drdo/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w @drdo/api"
  },
  "engines": {
    "node": ">=20"
  }
}
